      "get": {
        "operationId": "listProfiles",
        "summary": "Owned profiles in creation order",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Profile"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Problem Details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "core-foundation.v1.yaml#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": []
      },
