              "X-Correlation-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "default": {
            "description": "Problem Details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "core-foundation.v1.yaml#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Requires the HttpOnly CSRF cookie plus masked token from GET /v1/auth/csrf. No automatic mutation retries.",
