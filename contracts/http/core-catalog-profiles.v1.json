{
  "openapi": "3.1.0",
  "info": {
    "title": "LIBRA Core profiles and catalog",
    "version": "1.0.0",
    "description": "Milestone 3. Public metadata is not playback authorization. Unknown input fields are rejected. Cookie/CSRF details: core-identity.v1.json. Parent hiding returns 404 on direct access. All conflicts leave prior publication intact."
  },
  "servers": [
    {
      "url": "http://localhost:8081"
    },
    {
      "url": "http://localhost:8080/api/core"
    }
  ],
