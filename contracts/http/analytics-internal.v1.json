{
  "openapi": "3.1.0",
  "info": {
    "title": "LIBRA Analytics internal read contract",
    "version": "1.1.0",
    "description": "Read-only internal queries served by Recommendation/Analytics to Core only. Normative ownership, statistics, freshness, error and compatibility semantics: docs/analytics-contracts-ra01-1.md. 1.1.0 adds sanitized error responses only; request/response schemas are unchanged from 1.0.0 and Core still discards every non-200 body. Recommendations return movie/series IDs in rank order, the same profileId and the projection checkpoint updatedAt; Core filters current visibility and READY availability. Statistics echo the inclusive UTC window (at most 31 days, through today): qualifiedViews = sessions whose first qualifying event (cumulative accepted duration >= 30 s) falls in the window; uniqueViewers = distinct accounts among them over the whole window; acceptedWatchedMs = sum of Core-accepted increments by accepted-event UTC date. updatedAt is the confirmed consumer checkpoint, never the request time. Without a first checkpoint the server answers 503 ANALYTICS_NOT_READY, never 200 with zeros. Unknown fields are rejected in both directions; a new field or meaning requires /internal/v2. Executable fixtures: contracts/fixtures/analytics-v1/manifest.json."
  },
  "servers": [
    {
      "url": "https://analytics.example.test"
    }
  ],
  "security": [
    {
      "serviceJwt": []
    }
  ],
  "paths": {
    "/internal/v1/recommendations/query": {
      "post": {
        "operationId": "queryRecommendations",
        "summary": "Read-only internal query; requires exactly recommendations:read",
        "x-required-scope": "recommendations:read",
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete uncompressed JSON snapshot; maximum 65,536 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "405": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-error-codes": {
          "400": [
            "INVALID_REQUEST"
          ],
          "401": [
            "AUTHENTICATION_REQUIRED"
          ],
          "403": [
            "ACCESS_DENIED"
          ],
          "404": [
            "NOT_FOUND"
          ],
          "405": [
            "METHOD_NOT_ALLOWED"
          ],
          "413": [
            "PAYLOAD_TOO_LARGE"
          ],
          "415": [
            "UNSUPPORTED_MEDIA_TYPE"
          ],
          "429": [
            "RATE_LIMITED"
          ],
          "500": [
            "INTERNAL_ERROR"
          ],
          "503": [
            "ANALYTICS_NOT_READY",
            "ANALYTICS_UNAVAILABLE"
          ]
        }
      }
    },
    "/internal/v1/statistics/query": {
      "post": {
        "operationId": "queryStatistics",
        "summary": "Read-only internal query; requires exactly statistics:read",
        "x-required-scope": "statistics:read",
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatisticsQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete uncompressed JSON snapshot; maximum 65,536 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatisticsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "405": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-error-codes": {
          "400": [
            "INVALID_REQUEST"
          ],
          "401": [
            "AUTHENTICATION_REQUIRED"
          ],
          "403": [
            "ACCESS_DENIED"
          ],
          "404": [
            "NOT_FOUND"
          ],
          "405": [
            "METHOD_NOT_ALLOWED"
          ],
          "413": [
            "PAYLOAD_TOO_LARGE"
          ],
          "415": [
            "UNSUPPORTED_MEDIA_TYPE"
          ],
          "429": [
            "RATE_LIMITED"
          ],
          "500": [
            "INTERNAL_ERROR"
          ],
          "503": [
            "ANALYTICS_NOT_READY",
            "ANALYTICS_UNAVAILABLE"
          ]
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceJwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Pin a trusted dedicated RSA public key/kid (>=2048 bits), RS256 only. Require iss=libra-core-services, sub=libra-core, aud=[libra-recommendation-analytics], purpose=service-access, nonempty jti, iat <= now < exp, and 0 < exp-iat <= 60 seconds. Enforce exact endpoint scope string. Browser access JWTs/playback tickets/forwarded user headers are not service credentials. No arbitrary token-supplied key URL. No one-time replay guarantee."
      }
    },
    "schemas": {
      "RecommendationQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "profileId",
          "limit"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "profileId": {
            "type": "string",
            "format": "uuid"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "CandidateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profileId",
          "updatedAt",
          "contentIds"
        ],
        "properties": {
          "profileId": {
            "type": "string",
            "format": "uuid"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "contentIds": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "StatisticsQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "StatisticsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "updatedAt",
          "qualifiedViews",
          "uniqueViewers",
          "acceptedWatchedMs"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "qualifiedViews": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "uniqueViewers": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "acceptedWatchedMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "maxLength": 200
          },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "AUTHENTICATION_REQUIRED",
              "ACCESS_DENIED",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "ANALYTICS_NOT_READY",
              "ANALYTICS_UNAVAILABLE"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Sanitized Problem Details, sent as application/problem+json whatever the request Accept header says. Core discards the body and degrades to UNAVAILABLE/FALLBACK. 400 INVALID_REQUEST (schema or semantic request violation, including a window over 31 days or past today UTC); 401 AUTHENTICATION_REQUIRED (missing/invalid service JWT); 403 ACCESS_DENIED (wrong scope); 404 NOT_FOUND; 405 METHOD_NOT_ALLOWED; 413 PAYLOAD_TOO_LARGE; 415 UNSUPPORTED_MEDIA_TYPE; 429 RATE_LIMITED; 500 INTERNAL_ERROR; 503 ANALYTICS_NOT_READY (no confirmed checkpoint yet) or ANALYTICS_UNAVAILABLE (dependency failure). Never contains tokens, SQL, stack traces, raw event payloads or account/profile identifiers.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
