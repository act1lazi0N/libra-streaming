# Local development only. Replace these values outside a disposable workstation.
POSTGRES_SUPERUSER_PASSWORD=libra_local
SEAWEEDFS_ACCESS_KEY=libra
SEAWEEDFS_SECRET_KEY=libra_local_secret

# Required before starting Core. Use two different cryptographically random 32-byte
# values encoded as Base64. Keep them stable across restarts and out of Git/logs.
CORE_JWT_KEY=
CORE_MAIL_ENCRYPTION_KEY=
# These HTTP/cookie settings are only for local loopback development.
CORE_LOCAL_DEVELOPMENT=true
CORE_COOKIE_SECURE=false
CORE_PUBLIC_BASE_URL=http://localhost:8080
CORE_MAIL_STARTTLS=false
CORE_MEDIA_LISTENER_ENABLED=true
# Optional, both or neither. Bootstrap runs once and never promotes an existing user.
CORE_BOOTSTRAP_ADMIN_EMAIL=
CORE_BOOTSTRAP_ADMIN_PASSWORD=
